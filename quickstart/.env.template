#!/bin/bash
# AI Work Management Platform - Environment Variables Template
#
# ==============================================================================
# SECURITY BEST PRACTICE - TWO-FILE APPROACH
# ==============================================================================
#
# This template demonstrates a secure pattern for managing secrets when working
# with AI assistants like Claude Code:
#
# 1. NON-SENSITIVE CONFIG → Store in project .env (this file)
#    - Workspace paths, model names, base URLs, feature flags
#    - Safe for AI assistants to read
#    - Can be committed to git (still gitignored for flexibility)
#
# 2. SENSITIVE SECRETS → Store in ~/.secrets/ai-work-mgmt (OUTSIDE project)
#    - API keys, tokens, passwords
#    - Not accessible to AI assistants unless explicitly requested
#    - Never in git repository
#    - One file shared across all your projects
#
# ==============================================================================
# SETUP INSTRUCTIONS
# ==============================================================================
#
# 1. Copy this template to .env:
#    cp .env.template .env
#
# 2. Edit .env and customize workspace paths and model settings
#
# 3. Create external secrets file (ONE TIME SETUP):
#    mkdir -p ~/.secrets
#    chmod 700 ~/.secrets
#    touch ~/.secrets/ai-work-mgmt
#    chmod 600 ~/.secrets/ai-work-mgmt
#
# 4. Add API keys to ~/.secrets/ai-work-mgmt:
#    nano ~/.secrets/ai-work-mgmt
#
#    Add this content:
#    #!/bin/bash
#    export ANTHROPIC_API_KEY=sk-ant-your-actual-key-here
#    export GEMINI_API_KEY=your-gemini-key-here
#    export GROQ_API_KEY=your-groq-key-here
#
# 5. Run scripts - they automatically source both files:
#    ./run-llm-anthropic.sh
#

# ==============================================================================
# NON-SENSITIVE CONFIGURATION (safe to keep in project .env)
# ==============================================================================

# ------------------------------------------------------------------------------
# Workspace Configuration
# ------------------------------------------------------------------------------

# Where the platform stores work items, artifacts, and logs
export WORKSPACE_ROOT=/Users/dc24863/dev/PoC/AI-Assisted-Projects/AI-Work-Mgmt-LLM-Orch-AddOn
export WORKSPACE_NAME=workspace

# ------------------------------------------------------------------------------
# Anthropic (Claude) Configuration
# ------------------------------------------------------------------------------

# Model selection (non-sensitive)
export MODEL_ANTHROPIC=claude-sonnet-4-5-20250514

# Alternative models (uncomment to use):
# export MODEL_ANTHROPIC=claude-opus-4-6-20250514
# export MODEL_ANTHROPIC=claude-3-5-sonnet-20241022

# Custom base URL for corporate proxy (non-sensitive)
# Uncomment if routing through corporate gateway:
# export ANTHROPIC_BASE_URL=https://ai-model-proxy.aks-ur-prd-internal.8451.cloud

# ------------------------------------------------------------------------------
# Gemini Configuration (Optional)
# ------------------------------------------------------------------------------

# Model selection
# export MODEL_GEMINI=gemini-2.0-flash
# export MODEL_GEMINI=gemini-2.0-flash-lite
# export MODEL_GEMINI=gemini-pro

# Custom base URL for corporate proxy
# export GEMINI_BASE_URL=https://your-proxy.example.com

# ------------------------------------------------------------------------------
# Groq Configuration (Optional - Fast Inference)
# ------------------------------------------------------------------------------

# Model selection
# export MODEL_GROQ=llama-3.3-70b-versatile
# export MODEL_GROQ=llama-3.1-8b-instant
# export MODEL_GROQ=mixtral-8x7b-32768

# Custom base URL for corporate proxy
# export GROQ_BASE_URL=https://your-proxy.example.com

# ------------------------------------------------------------------------------
# Advanced Options
# ------------------------------------------------------------------------------

# Spring Boot devtools (leave disabled for LLM mode)
# export SPRING_DEVTOOLS_RESTART_ENABLED=false

# Logging level
# export LOGGING_LEVEL_ORCHESTRATION=DEBUG

# ==============================================================================
# SENSITIVE CONFIGURATION (store in ~/.secrets/ai-work-mgmt)
# ==============================================================================

# Source API keys from external file (OUTSIDE this git repository)
# This file should contain ONLY sensitive credentials

if [ -f ~/.secrets/ai-work-mgmt ]; then
  source ~/.secrets/ai-work-mgmt
else
  echo "" >&2
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" >&2
  echo "⚠️  WARNING: API keys file not found" >&2
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" >&2
  echo "" >&2
  echo "API keys should be stored in: ~/.secrets/ai-work-mgmt" >&2
  echo "" >&2
  echo "To set up (one-time):" >&2
  echo "" >&2
  echo "  # 1. Create secrets directory" >&2
  echo "  mkdir -p ~/.secrets" >&2
  echo "  chmod 700 ~/.secrets" >&2
  echo "" >&2
  echo "  # 2. Create secrets file" >&2
  echo "  nano ~/.secrets/ai-work-mgmt" >&2
  echo "" >&2
  echo "  Add this content:" >&2
  echo "  #!/bin/bash" >&2
  echo "  export ANTHROPIC_API_KEY=sk-ant-your-key-here" >&2
  echo "  export GEMINI_API_KEY=your-gemini-key-here" >&2
  echo "  export GROQ_API_KEY=your-groq-key-here" >&2
  echo "" >&2
  echo "  # 3. Secure permissions" >&2
  echo "  chmod 600 ~/.secrets/ai-work-mgmt" >&2
  echo "" >&2
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" >&2
  echo "" >&2
fi

# ==============================================================================
# WHY THIS APPROACH?
# ==============================================================================
#
# ✅ Security from AI Assistants
#    - AI can read .env (project config) but not ~/.secrets (API keys)
#    - Even if AI reads .env, no credentials are exposed
#
# ✅ Security from Git
#    - .env is gitignored (can't be committed by accident)
#    - ~/.secrets is outside repo (can NEVER be committed)
#
# ✅ Convenience
#    - One secrets file (~/.secrets/ai-work-mgmt) for all projects
#    - Easy to rotate keys (update once, affects all projects)
#    - Can safely share entire project folder with colleagues
#
# ✅ Industry Best Practice
#    - Separation of config (non-sensitive) and secrets (sensitive)
#    - Follows 12-factor app methodology
#    - Same pattern used by Docker, Kubernetes, cloud platforms
#
# ==============================================================================
